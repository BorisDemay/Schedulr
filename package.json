{
    "name": "schedulr-ts",
    "version": "1.0.0",
    "description": "A Discord bot for scheduling meetings (TypeScript version)",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "build": "tsc",
        "watch": "tsc -w",
        "dev": "tsc && node dist/index.js",
        "test": "ts-node test/service.test.ts",
        "lint": "tsc --noEmit",
        "validate": "npm run lint && npm run test",
        "clean": "rimraf dist",
        "build:clean": "npm run clean && npm run build"
    },
    "dependencies": {
        "discord.js": "^14.14.1",
        "dotenv": "^16.3.1",
        "node-schedule": "^2.1.1",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/node-schedule": "^2.1.0",
        "@types/uuid": "^9.0.8",
        "cross-env": "^7.0.3",
        "rimraf": "^5.0.5",
        "ts-node": "^10.9.1",
        "typescript": "^5.3.2"
    }
}